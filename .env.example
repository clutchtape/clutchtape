# Copy to .env and fill in. Never commit .env.

# --- required ---
# e.g. python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# for /admin (Xbox login, players, privacy requests)
ADMIN_PASSWORD=change-me

# --- your site ---
# every hostname you serve on, comma-separated (e.g. stats.example.com)
TRUSTED_HOSTS=localhost,127.0.0.1
# set 1 when served over HTTPS
COOKIE_SECURE=0
TZ=UTC

# --- optional: Twitch (auto clips, synced VODs, Watch together, live panel) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- optional: Xbox app credentials (can also be entered on /admin) ---
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_REDIRECT_URI=http://localhost

# --- optional: home page examples ---
# "Gamertag|twitchlogin,Gamertag2|login2,Gamertag3"
FEATURED_PLAYERS=
# "Gamertag,Gamertag2" shown as "Try a pro"
DEMO_SOLO=
# "Label=slug-a,slug-b,slug-c"
DEMO_SQUADS=

# --- optional: limits & tuning ---
# new gamertag lookups per visitor per hour
ADDS_PER_HOUR=12
MAX_PLAYERS=2000
# games loaded per new player
FIRST_SYNC_MATCHES=200
WEB_THREADS=8
LOG_LEVEL=INFO
# optional tip-jar link in the header
TIP_URL=
